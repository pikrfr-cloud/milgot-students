# Public Next.js vars. GitHub Pages builds leave these empty.
# Never put a live phone number, Twilio SID, or analytics token here.

# WhatsApp bot for the results-page reminder button. Empty → button hidden.
# Placeholder only — not a real number.
NEXT_PUBLIC_WHATSAPP_BOT_NUMBER=9725XXXXXXXX

# Privacy-safe page analytics (Plausible-compatible). Both required to enable.
# Empty → no script and no outbound analytics request (default GitHub Pages).
NEXT_PUBLIC_ANALYTICS_URL=
NEXT_PUBLIC_ANALYTICS_SITE_ID=
